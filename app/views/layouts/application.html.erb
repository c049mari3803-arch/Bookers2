<!DOCTYPE html>
<html>
  <head>
    <title>Bookers2</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- 共通のヘッダー -->
    <header class="shadow-sm">
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
          <%= link_to "Bookers", root_path, class: "navbar-brand" %>
          <div class="collapse navbar-collapse justify-content-end" id="navbarNavDropdown">
            <ul class="navbar-nav ml-auto">
              <% if authenticated? %>
                <li class="nav-item">
                  <%= link_to user_path(Current.user), class: "nav-link text-light" do %>
                  <i class="fas fa-home"></i> Home
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to users_path, class: "nav-link text-light" do %>
                  <i class="fas fa-users"></i> Users
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to books_path, class: "nav-link text-light" do %>
                  <i class="fas fa-book-open"></i> Books
                  <% end%>
                </li>
                <li class="nav-item">
                  <%= link_to session_path, data: { turbo_method: :delete }, class: "nav-link text-light bg-transparent border-0" do %>
                  <i class="fas fa-sign-out-alt"></i> Log out
                  <% end %>
                </li>
              <% else %>
                <li class="nav-item">
                  <%= link_to root_path, class: "nav-link text-light" do %>
                  <i class="fas fa-home"></i> Home
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to home_about_path, class: "nav-link text-light" do %>
                  <i class="fas fa-link"></i> About
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to new_user_path, class: "nav-link text-light" do %>
                  <i class="fas fa-user-plus"></i> Sign up
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to new_session_path, class: "nav-link text-light" do %>
                  <i class="fas fa-sign-in-alt"></i>Log in
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </nav>
    </header>

<main class="container px-5 px-sm-0 mt-3">
      <% flash.each do |key, message| %>
        <p class="<%= key %>"><%= message %></p>
      <% end %>

      <% if authenticated? && !current_page?(root_path) && !(controller_name == 'books' && (action_name == 'edit' || action_name == 'update')) %>
        <div class="row">
          <div class="col-md-3">
          
          <% if @book.present? && @book.errors.any? %>
  <div id="error_explanation" class="text-danger mb-3">
    <h3><%= pluralize(@book.errors.count, "error") %> prohibited this obj from being saved:</h3>
    <ul>
      <% @book.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

            <h2>User info</h2>
            <table class="table">
              <tr>
                <% target_user = @user || Current.user %>
      
                  <% if target_user.profile_image.attached? %>
                  <%= image_tag target_user.profile_image, size: "100x100" %>
                  <% else %>
                  <%= image_tag "no_image.jpg", size: "100x100" %>
                <% end %>
              </tr>
              <tr>
                <th>name</th>
                  <th><%= target_user.name %></th>
              </tr>
              <tr>
              <th>introduction</th>
                <th><%= target_user.introduction %></th>
              </tr>
            </table>

  <div class="row">
    <%= link_to edit_user_path(target_user), class: "btn btn-outline-secondary btn-block w-100" do %>
      <i class="fas fa-user-cog"></i>
    <% end %>
  </div>

            <h2 class="mt-3">New book</h2>
            <%= form_with model: @new_book || @book || Book.new, url: books_path, local: true do |f| %>
              <div class="form-group mb-3">
                <label for="book_title">Title</label>
                <%= f.text_field :title, class: 'form-control book_title w-100' %>
              </div>
              <div class="form-group mb-3">
                <label for="book_body">Opinion</label>
                <%= f.text_area :body, class: 'form-control book_body w-100' %>
              </div>
              <div class="form-group">
                <%= f.submit 'Create Book', class: 'btn btn-success' %>
              </div>
            <% end %>
          </div>

          <div class="col-md-8 offset-md-1">
            <%= yield %>
          </div>
        </div>
      <% else %>
        <%= yield %>
      <% end %>
    </main>

<footer class="text-center mt-4">
      <div class="container">
        <div class="row">
          <div class="mx-auto">
            <p>CopyRight Infratop.inc</p>
          </div>
        </div>
      </div>
    </footer>

  </body>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</html>