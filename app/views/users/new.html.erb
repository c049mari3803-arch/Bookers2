<h2>Sign up</h2>
  <% if @user.errors.any? %>
    <div id="error_explanation">
      <h3><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h3>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
      <%= form_with model: @user, url: users_path, local: true do |f| %>

        <div class="form-group mb-3">
          <label for="user_name">Name</label><br>
          <%= f.text_field :name, autofocus: true, class: "form-control w-25" %>
        </div>

        <div class="form-group mb-3">
          <label for="user_email_address">Email</label><br>
          <%= f.email_field :email_address, class: "form-control w-25" %>
        </div>

        <div class="form-group mb-3">
          <label for="user_password">Password</label>
          <em>(6 characters minimum)</em><br>
          <%= f.password_field :password, class: "form-control w-25" %>
        </div>

        <div class="form-group mb-3">
          <label for="user_password_confirmation">Password confirmation</label><br>
          <%= f.password_field :password_confirmation, class: "form-control w-25" %>
        </div>

        <div class="form-group mb-3">
          <%= f.submit "Sign up", class: "btn btn-success" %>
        </div>
      <% end %>

      <%= link_to "Log in", new_session_path %>
    </div>
  </div>
</div>